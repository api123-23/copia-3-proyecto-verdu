NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave para crear usuarios desde el panel de administración (service_role).
# Se obtiene en Supabase → Settings → API. NO exponerla al frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Clave de la API de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Clave del fallback gratuito de OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
